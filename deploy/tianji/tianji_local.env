#!/usr/bin/env bash
# Shared local environment bootstrap for all Tianji Stage1/Stage2/DAgger/Car launchers.
# Sources an untracked site.env (if found) and computes the chunk/prefetch timetable.

_tianji_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export RLINF_ROOT="${RLINF_ROOT:-$(cd -- "${_tianji_script_dir}/../.." && pwd)}"
export TIANJI_DEPLOY_ROOT="${TIANJI_DEPLOY_ROOT:-${_tianji_script_dir}}"

if [[ "${TIANJI_SKIP_SITE_ENV:-0}" == "1" ]]; then
  :
elif [[ -n "${TIANJI_SITE_ENV:-}" && -f "${TIANJI_SITE_ENV}" ]]; then
  # shellcheck disable=SC1090
  source "${TIANJI_SITE_ENV}"
elif [[ -f "${_tianji_script_dir}/site.env" ]]; then
  # shellcheck disable=SC1091
  source "${_tianji_script_dir}/site.env"
elif [[ -f "${RLINF_ROOT}/site.env" ]]; then
  # shellcheck disable=SC1091
  source "${RLINF_ROOT}/site.env"
elif [[ -f "${HOME}/.config/tianji/site.env" ]]; then
  # shellcheck disable=SC1091
  source "${HOME}/.config/tianji/site.env"
fi

export LOOPINFRA_ROOT="${LOOPINFRA_ROOT:-${HOME}/LoopInfra}"
export TIANJI_RUNTIME_DIR="${TIANJI_RUNTIME_DIR:-${RLINF_ROOT}/.runtime/tianji}"
export TIANJI_RUNS_DIR="${TIANJI_RUNS_DIR:-${RLINF_ROOT}/runs}"
export TIANJI_RUNS_ROOT="${TIANJI_RUNS_ROOT:-${TIANJI_RUNS_DIR}}"

if [[ -z "${RLINF_PYTHON:-}" ]]; then
  if [[ -n "${TIANJI_GPU_PYTHON:-}" ]]; then
    RLINF_PYTHON="${TIANJI_GPU_PYTHON}"
  elif [[ -n "${PYTHON_BIN:-}" ]]; then
    RLINF_PYTHON="${PYTHON_BIN}"
  elif [[ -x "${RLINF_ROOT}/.venv-gpu/bin/python" ]]; then
    RLINF_PYTHON="${RLINF_ROOT}/.venv-gpu/bin/python"
  else
    RLINF_PYTHON="$(command -v python3 || command -v python)"
  fi
fi
export RLINF_PYTHON
export TIANJI_CPU_PYTHON="${TIANJI_CPU_PYTHON:-${RLINF_PYTHON}}"
export TIANJI_GPU_PYTHON="${TIANJI_GPU_PYTHON:-${RLINF_PYTHON}}"
export PYTHON_BIN="${PYTHON_BIN:-${TIANJI_GPU_PYTHON}}"

if [[ -z "${LOOPINFRA_PYTHON:-}" && -f "${LOOPINFRA_ROOT}/.loopinfra-python" ]]; then
  LOOPINFRA_PYTHON="$(<"${LOOPINFRA_ROOT}/.loopinfra-python")"
fi
if [[ -n "${LOOPINFRA_PYTHON:-}" ]]; then
  export LOOPINFRA_PYTHON
fi

export TIANJI_MODEL_DIR="${TIANJI_MODEL_DIR:-${RLINF_ROOT}/models/stage1_v1}"
export TIANJI_RLT_STAGE1_MODEL_PATH="${TIANJI_RLT_STAGE1_MODEL_PATH:-${TIANJI_MODEL_DIR}}"
export TIANJI_RLT_STAGE1_NORM_STATS_PATH="${TIANJI_RLT_STAGE1_NORM_STATS_PATH:-${TIANJI_RLT_STAGE1_MODEL_PATH}/norm_stats.json}"
export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-${HOME}/.cache/openpi}"
export HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
export TIANJI_HIL_PORT="${TIANJI_HIL_PORT:-8879}"
export LOOPINFRA_URL="${LOOPINFRA_URL:-http://127.0.0.1:8780}"
export TIANJI_WUJI_SPEED="${TIANJI_WUJI_SPEED:-trial45}"
export PYTHONPATH="${RLINF_ROOT}${EXTRA_GPU_SITE_PACKAGES:+:${EXTRA_GPU_SITE_PACKAGES}}${PYTHONPATH:+:${PYTHONPATH}}"
export EMBODIED_PATH="${RLINF_ROOT}/examples/embodiment"
export PYTHONDONTWRITEBYTECODE=1
export RLINF_SKIP_REALWORLD_SETUP=1
export RLINF_REALWORLD_PLATFORM=tianji
export USE_TF=0
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"

export TIANJI_CONTROL_HZ="${TIANJI_CONTROL_HZ:-30}"
export TIANJI_ACTION_HORIZON="${TIANJI_ACTION_HORIZON:-60}"
export TIANJI_SUBTASK_PROMPTS="${TIANJI_SUBTASK_PROMPTS-${_tianji_script_dir}/tianji_subtasks_box_v5.json}"

if ! tianji_schedule="$("${TIANJI_CPU_PYTHON}" "${_tianji_script_dir}/tianji_schedule_env.py")"; then
  echo "Invalid TIANJI_ACTION_HORIZON/TIANJI_CONTROL_HZ or subtask prompts JSON" >&2
  unset _tianji_script_dir
  return 2 2>/dev/null || exit 2
fi
eval "${tianji_schedule}"
unset tianji_schedule
unset RLT_ACTION_ENV_SCALE RLT_ACTION_ENV_BIAS RLINF_TIANJI_STAGE1_ONLY

export JAX_PLATFORMS=cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export TMPDIR="${TMPDIR:-${TIANJI_RUNTIME_DIR}/tmp}"
export RAY_TMPDIR="${RAY_TMPDIR:-${TIANJI_RUNTIME_DIR}}"
export RLT_READY_FLAG="${RLT_READY_FLAG:-${TIANJI_RUNTIME_DIR}/rlt_rollout_ready}"
mkdir -p "${TMPDIR}" "${TIANJI_RUNTIME_DIR}"
export RAY_enable_worker_prestart=0
export RAY_prestart_worker_first_driver=0
unset _tianji_script_dir
