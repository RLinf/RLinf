# Machine-local deployment overrides for Tianji HIL (do NOT commit filled secrets/IDs).
# Copy to an untracked site.env (e.g. deploy/tianji/site.env or ~/.config/tianji/site.env)
# and source before launching RLinf Tianji workflows.

# --- Repositories & Python Environments ---
# Leave RLINF_ROOT unset when sourcing via deploy/tianji/tianji_local.env to auto-detect repo root.
export RLINF_ROOT="${RLINF_ROOT:-$HOME/RLinf}"
export LOOPINFRA_ROOT="${LOOPINFRA_ROOT:-$HOME/LoopInfra}"
export RLINF_PYTHON="${RLINF_PYTHON:-$HOME/miniconda3/envs/train/bin/python}"
export TIANJI_CPU_PYTHON="${TIANJI_CPU_PYTHON:-$RLINF_PYTHON}"
export TIANJI_GPU_PYTHON="${TIANJI_GPU_PYTHON:-$RLINF_PYTHON}"
# Optional LoopInfra Python override (otherwise read from $LOOPINFRA_ROOT/.loopinfra-python):
# export LOOPINFRA_PYTHON="$HOME/miniconda3/envs/loopinfra/bin/python"
# Optional extra site-packages (e.g. OpenPI/GPU venv) if split from RLINF_PYTHON:
# export EXTRA_GPU_SITE_PACKAGES="/path/to/.venv-gpu/lib/python3.11/site-packages"
export PYTHONPATH="$RLINF_ROOT${EXTRA_GPU_SITE_PACKAGES:+:$EXTRA_GPU_SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"
export EMBODIED_PATH="$RLINF_ROOT/examples/embodiment"

# --- RLinf Realworld Platform Guards ---
export RLINF_REALWORLD_PLATFORM=tianji
export RLINF_SKIP_REALWORLD_SETUP=1
export PYTHONDONTWRITEBYTECODE=1

# --- LoopInfra Collector Interface ---
export LOOPINFRA_URL="${LOOPINFRA_URL:-http://127.0.0.1:8780}"
# export LOOPINFRA_TOKEN=""
export TIANJI_HIL_PORT="${TIANJI_HIL_PORT:-8879}"

# --- Model, Output & Prompt Assets ---
export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-$HOME/.cache/openpi}"
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export TIANJI_MODEL_DIR="${TIANJI_MODEL_DIR:-$RLINF_ROOT/models/stage1_v1}"
export TIANJI_RLT_STAGE1_MODEL_PATH="${TIANJI_RLT_STAGE1_MODEL_PATH:-$TIANJI_MODEL_DIR}"
export TIANJI_RLT_STAGE1_NORM_STATS_PATH="${TIANJI_RLT_STAGE1_NORM_STATS_PATH:-$TIANJI_RLT_STAGE1_MODEL_PATH/norm_stats.json}"
export TIANJI_RUNS_DIR="${TIANJI_RUNS_DIR:-$RLINF_ROOT/runs}"
export TIANJI_RUNTIME_DIR="${TIANJI_RUNTIME_DIR:-$RLINF_ROOT/.runtime/tianji}"
# export TIANJI_SUBTASK_PROMPTS="/path/to/prompts.json"

# --- Control & Schedule Contract ---
export TIANJI_ACTION_SPACE="${TIANJI_ACTION_SPACE:-joint}"
export TIANJI_CONTROL_HZ="${TIANJI_CONTROL_HZ:-30}"
export TIANJI_ACTION_HORIZON="${TIANJI_ACTION_HORIZON:-60}"
export TIANJI_RT_SCHEDULE="${TIANJI_RT_SCHEDULE:-1}"
export TIANJI_ROW_SCALE="${TIANJI_ROW_SCALE:-1}"
export TIANJI_DENSE_ROWS="${TIANJI_DENSE_ROWS:-0}"

# --- Workflow Modes ---
# 0 = keep executing frozen VLA reference (safe for DAgger/inference); 1 = sync Actor updates (Online RL)
export TIANJI_DEPLOY_ACTOR_UPDATES="${TIANJI_DEPLOY_ACTOR_UPDATES:-0}"
export TIANJI_PI05_SERVICE="${TIANJI_PI05_SERVICE:-0}"
export TIANJI_TACTILE_REQUIRED="${TIANJI_TACTILE_REQUIRED:-0}"

# --- Optional: Car 1118v1 / Sub6 Deployment Parameters & Verification IDs ---
# export TIANJI_CAR_1118=1
# export TIANJI_CAR_NUM_SUBTASKS=15        # 15 (full numbered) or 6 (sub6)
# export TIANJI_CAR_BANNER="Stage2-30HZ-1118v1"
# export TIANJI_CAR_NAS_SOURCE="/path/to/nas/car_checkpoint_root"
# export TIANJI_CAR_POSE_CONFIG_ID="<sha256>"
# export TIANJI_CAR_RESET_POSE_ID="<sha256>"
# export TIANJI_CAR_MONITOR_SOCKET="/run/user/1000/tianji-car-monitor.sock"
