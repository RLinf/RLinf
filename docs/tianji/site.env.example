# Machine-local deployment overrides for Tianji HIL (do NOT commit filled secrets/IDs).
# Copy to an untracked site.env and source before launching RLinf Tianji workflows.

# --- Repositories & Python Environments ---
export RLINF_ROOT="$HOME/RLinf-tianji-hil"
export LOOPINFRA_ROOT="$HOME/LoopInfra"
export TIANJI_CPU_PYTHON="$HOME/miniconda3/envs/train/bin/python"
export TIANJI_GPU_PYTHON="$TIANJI_CPU_PYTHON"
# Optional extra site-packages (e.g. OpenPI/GPU venv) if split from TIANJI_GPU_PYTHON:
# export EXTRA_GPU_SITE_PACKAGES="/path/to/.venv-gpu/lib/python3.11/site-packages"
export PYTHONPATH="$RLINF_ROOT${EXTRA_GPU_SITE_PACKAGES:+:$EXTRA_GPU_SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"
export EMBODIED_PATH="$RLINF_ROOT/examples/embodiment"

# --- RLinf Realworld Platform Guards ---
export RLINF_REALWORLD_PLATFORM=tianji
export RLINF_SKIP_REALWORLD_SETUP=1
export PYTHONDONTWRITEBYTECODE=1

# --- LoopInfra Collector Interface ---
export LOOPINFRA_URL="http://127.0.0.1:8780"
# export LOOPINFRA_TOKEN=""
export TIANJI_HIL_PORT=8879

# --- Model & Prompt Assets ---
export OPENPI_DATA_HOME="$HOME/.cache/openpi"
export TIANJI_RLT_STAGE1_MODEL_PATH="/path/to/stage1_checkpoint"
export TIANJI_RLT_STAGE1_NORM_STATS_PATH="$TIANJI_RLT_STAGE1_MODEL_PATH/norm_stats.json"
# export TIANJI_SUBTASK_PROMPTS="/path/to/prompts.json"

# --- Control & Schedule Contract ---
export TIANJI_ACTION_SPACE=joint
export TIANJI_CONTROL_HZ=30
export TIANJI_ACTION_HORIZON=60
export TIANJI_RT_SCHEDULE=1
export TIANJI_ROW_SCALE=1
export TIANJI_DENSE_ROWS=0

# --- Workflow Modes ---
# 0 = keep executing frozen VLA reference (safe for DAgger/inference); 1 = sync Actor updates (Online RL)
export TIANJI_DEPLOY_ACTOR_UPDATES=0
export TIANJI_PI05_SERVICE=0
export TIANJI_TACTILE_REQUIRED=0

# --- Optional: Car 1118v1 Deployment Verification IDs ---
# export TIANJI_CAR_1118=1
# export TIANJI_CAR_POSE_CONFIG_ID="<sha256>"
# export TIANJI_CAR_RESET_POSE_ID="<sha256>"
