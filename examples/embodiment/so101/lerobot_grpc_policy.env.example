# Copy this file to lerobot_grpc_policy.env and set paths for your host.
SO101_GRPC_CHECKPOINT=/path/to/rlinf/checkpoints/global_step_10000/actor
SO101_GRPC_NORM_STATS=/path/to/so101/norm_stats.json
SO101_GRPC_HOST=127.0.0.1
# Set to 1 only when the endpoint is protected by a trusted tunnel/network.
SO101_GRPC_ALLOW_INSECURE_REMOTE=0
SO101_GRPC_PORT=50051
SO101_GRPC_CUDA_VISIBLE_DEVICES=0
SO101_GRPC_DEVICE=cuda:0
SO101_GRPC_FPS=15
SO101_GRPC_TMUX_SESSION=so101_lerobot_grpc
SO101_GRPC_LOG=${SO101_GRPC_LOG:-examples/embodiment/so101/lerobot_grpc_policy.log}
RLINF_PYTHON=${RLINF_PYTHON:-python}
